# Copie a .env y complete. Nunca suba .env al repositorio.
# Generar claves:  python -m app.cli gen-key   |   python -c "import secrets;print(secrets.token_urlsafe(48))"

# --- General ---
# dev | test | prod. En prod se validan secretos fuertes al arrancar.
VAI_ENV=dev
VAI_DEBUG=false

# --- Base de datos y colas ---
# SQLite para desarrollo; Postgres en prod (compose lo sobreescribe).
VAI_DATABASE_URL=sqlite+aiosqlite:///./vendedores.db
# Vacio = jobs en proceso (dev). En prod: redis://redis:6379/0
VAI_REDIS_URL=
# Solo docker compose (Postgres)
POSTGRES_PASSWORD=cambiar-esta-clave

# --- Seguridad ---
# Minimo 32 caracteres, aleatoria (firma de sesiones/CSRF/OAuth state).
VAI_SECRET_KEY=
# JSON {"v1":"<base64 32 bytes>"}; la primera es la activa. Obligatoria en prod.
VAI_MASTER_KEYS=
# Clave HMAC para el indice ciego de telefonos. Obligatoria en prod.
VAI_PHONE_HASH_KEY=
VAI_SESSION_TTL_MIN=480
VAI_SESSION_ABSOLUTE_TTL_DAYS=7
# Debe ser true en prod (HTTPS).
VAI_COOKIE_SECURE=true
# Lista JSON de hosts permitidos, ej. ["app.midominio.com"]
# En produccion: lista explicita, p. ej. ["app.tudominio.com"] (el arranque falla con "*")
VAI_ALLOWED_HOSTS=["*"]
VAI_LOGIN_MAX_ATTEMPTS=5
VAI_LOGIN_WINDOW_MIN=15
VAI_LOCKOUT_MIN=15
# URL publica (firma de webhooks Twilio y redirect de Google OAuth).
VAI_PUBLIC_BASE_URL=http://localhost:8000

# --- Regionalizacion y datos ---
VAI_DEFAULT_TZ=America/Bogota
# Dias de retencion de mensajes (Ley 1581).
VAI_MSG_RETENTION_DAYS=90

# --- Anthropic ---
VAI_ANTHROPIC_API_KEY=
VAI_ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Twilio (cuenta de la agencia) ---
VAI_TWILIO_ACCOUNT_SID=
VAI_TWILIO_AUTH_TOKEN=
# Formato whatsapp:+14155238886 (sandbox) o su sender aprobado.
VAI_TWILIO_WHATSAPP_FROM=
VAI_TWILIO_MESSAGING_SERVICE_SID=
# true = no envia mensajes reales (solo registra). Dejar en true hasta validar.
VAI_TWILIO_DRY_RUN=true
# Interruptor general de campanas de outreach (kill switch).
VAI_OUTREACH_ENABLED=false

# --- Google ---
VAI_GOOGLE_PLACES_API_KEY=
# Tope mensual de gasto de Places (USD); la busqueda se detiene al alcanzarlo.
VAI_GOOGLE_PLACES_BUDGET_USD_MONTH=50.0
VAI_GOOGLE_OAUTH_CLIENT_ID=
VAI_GOOGLE_OAUTH_CLIENT_SECRET=

# --- Demo ---
VAI_DEMO_ENABLED=true
VAI_DEMO_TOKEN_TTL_DAYS=7
VAI_DEMO_MAX_MESSAGES=30
VAI_DEMO_WHATSAPP_NUMBER=

# --- Despliegue con Caddy (docker-compose.prod.yml) ---
DOMAIN=app.midominio.com
ACME_EMAIL=admin@midominio.com

# --- Pagos en línea (Wompi) ---
VAI_WOMPI_PUBLIC_KEY=
VAI_WOMPI_PRIVATE_KEY=
VAI_WOMPI_EVENTS_SECRET=
VAI_WOMPI_INTEGRITY_SECRET=
VAI_WOMPI_SANDBOX=true
VAI_WOMPI_BASE_URL=
VAI_WOMPI_REDIRECT_URL=http://localhost:8000/pagos/retorno
VAI_WOMPI_LINK_TEMPLATE_SID=

# --- Voz (Twilio Voice) ---
VAI_VOICE_SAY_VOICE=Polly.Mia-Neural
